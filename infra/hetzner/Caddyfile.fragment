mowadhabah.com {
    import cloudflare_only
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    encode zstd gzip
    reverse_proxy mowadhabah-frontend:80 {
        lb_try_duration 15s
        lb_try_interval 250ms
        header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
    }
    header -Server
    log {
        output stdout
        format json
    }
}

www.mowadhabah.com {
    import cloudflare_only
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    redir https://mowadhabah.com{uri} permanent
}
