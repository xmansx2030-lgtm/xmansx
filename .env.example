# ============================================================
# xmansx — Environment Variables (قيم وهمية — انسخ إلى .env وعدّل)
# ممنوع وضع القيم الحقيقية في Git
# ============================================================

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# production فقط:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_SESSION_COOKIE_AGE=43200

# ---- PostgreSQL ----
POSTGRES_DB=xmansx
POSTGRES_USER=xmansx
POSTGRES_PASSWORD=xmansx-dev
POSTGRES_HOST=localhost
# 5433 عند التشغيل خارج Docker (الحاوية منشورة على 5433 لتفادي تعارض 5432 المحلي)
POSTGRES_PORT=5433

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Observability / error tracking (optional and privacy-first) ----
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# OPERATIONAL_HEARTBEAT_INTERVAL_SECONDS=120
# OPERATIONAL_HEARTBEAT_MAX_AGE_SECONDS=300

# ---- Backup / disaster recovery ----
# Local paths are for drills and staging only. Production must use a private remote repository.
# DATABASE_BACKUP_ROOT=/var/lib/xmansx/backup-staging
# BACKUP_ENVIRONMENT=production
# BACKUP_REMOTE_ENABLED=true
# BACKUP_REQUIRE_REMOTE=true
# BACKUP_STORAGE_BACKEND=storages.backends.s3.S3Storage
# BACKUP_STORAGE_LOCATION=database-backups
# AWS_STORAGE_BUCKET_NAME=xmansx-private-backups
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_ACCESS_KEY_ID=from-secret-manager
# AWS_SECRET_ACCESS_KEY=from-secret-manager
# BACKUP_SCHEDULE_ENABLED=false
# BACKUP_SCHEDULE_INTERVAL_SECONDS=86400

# ---- تشفير المعرفات (إلزامية في الإنتاج) ----
# ولّد مفتاح Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# التدوير: أضف الجديد أول القائمة (مفصولة بفواصل)، أعد التشفير، ثم أزل القديم
FIELD_ENCRYPTION_KEYS=generate-a-real-fernet-key-for-production
NATIONAL_ID_HMAC_KEY=generate-a-long-random-hmac-key-for-production

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=/api/v1

# ---- Sentry (لاحقًا — اتركه فارغًا محليًا) ----
# SENTRY_DSN=
