# ============================================================
# xmansx — Environment Variables (قيم وهمية — انسخ إلى .env وعدّل)
# ممنوع وضع القيم الحقيقية في Git
# ============================================================

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# production فقط:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_SESSION_COOKIE_AGE=43200

# ---- PostgreSQL ----
POSTGRES_DB=xmansx
POSTGRES_USER=xmansx
POSTGRES_PASSWORD=xmansx-dev
POSTGRES_HOST=localhost
# 5433 عند التشغيل خارج Docker (الحاوية منشورة على 5433 لتفادي تعارض 5432 المحلي)
POSTGRES_PORT=5433
# Optional native psycopg pool (enable on multi-threaded production web replicas).
# Each process owns its own pool; size the database limit for all web/worker processes.
# DATABASE_POOL_ENABLED=true
# DATABASE_POOL_MIN_SIZE=1
# DATABASE_POOL_MAX_SIZE=4
# DATABASE_POOL_MAX_WAITING=16
# DATABASE_POOL_TIMEOUT_SECONDS=5
# DATABASE_POOL_MAX_IDLE_SECONDS=300
# DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
# DATABASE_CONNECT_TIMEOUT_SECONDS=5
# DATABASE_CONN_MAX_AGE=60

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
# Keep separate services in scaled production. Logical DBs are sufficient for local development.
# CACHE_REDIS_URL=redis://localhost:6379/0
# SECURITY_REDIS_URL=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/2
# CELERY_RESULT_BACKEND=redis://localhost:6379/3
# Per-process bounds; the security store fails closed on errors.
# CACHE_REDIS_MAX_CONNECTIONS=8
# SECURITY_REDIS_MAX_CONNECTIONS=8
# CACHE_REDIS_POOL_TIMEOUT_SECONDS=0.25
# SECURITY_REDIS_POOL_TIMEOUT_SECONDS=0.25
# CACHE_REDIS_CONNECT_TIMEOUT_SECONDS=1
# SECURITY_REDIS_CONNECT_TIMEOUT_SECONDS=1
# CACHE_REDIS_SOCKET_TIMEOUT_SECONDS=1
# SECURITY_REDIS_SOCKET_TIMEOUT_SECONDS=1
# DASHBOARD_CACHE_WAIT_SECONDS=5
# DASHBOARD_CACHE_LEASE_SECONDS=30
# Account limits are shared by all replicas; school IP addresses are not limited here.
# API_RATE_LIMIT_ENABLED=true
# API_USER_REQUESTS_PER_MINUTE=240
# API_USER_EXPORTS_PER_MINUTE=12
# CELERY_BROKER_POOL_LIMIT=4
# CELERY_BROKER_MAX_CONNECTIONS=16
# CELERY_RESULT_MAX_CONNECTIONS=8

# ---- Observability / error tracking (optional and privacy-first) ----
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# OPERATIONAL_HEARTBEAT_INTERVAL_SECONDS=120
# OPERATIONAL_HEARTBEAT_MAX_AGE_SECONDS=300
# Session expiry remains rolling, but authenticated activity writes the database
# session at this cadence rather than on every API request.
# SESSION_ACTIVITY_TOUCH_INTERVAL_SECONDS=300
# CELERY_RESULT_EXPIRES=3600

# ---- Cloudflare R2 (production) ----
# Keep both buckets private. Generate a scoped R2 token; never commit its values.
# R2_ENABLED=true
# R2_ENDPOINT_URL=https://022def225c37a0d562ed34647c0bc7fb.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=from-secret-manager
# R2_SECRET_ACCESS_KEY=from-secret-manager
# R2_PRIVATE_BUCKET_NAME=xmansx-private
# R2_BACKUP_BUCKET_NAME=xmansx-backups
# R2_MEDIA_PREFIX=media
# R2_DOCUMENTS_PREFIX=documents
# R2_BACKUPS_PREFIX=database-backups

# ---- Backup / disaster recovery ----
# Local paths are for drills and staging only. Production uses the R2 backup bucket above.
# DATABASE_BACKUP_ROOT=/var/lib/xmansx/backup-staging
# BACKUP_ENVIRONMENT=production
# BACKUP_REMOTE_ENABLED=true
# BACKUP_REQUIRE_REMOTE=true
# BACKUP_SCHEDULE_ENABLED=true
# BACKUP_SCHEDULE_INTERVAL_SECONDS=86400

# ---- تشفير المعرفات (إلزامية في الإنتاج) ----
# ولّد مفتاح Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# التدوير: أضف الجديد أول القائمة (مفصولة بفواصل)، أعد التشفير، ثم أزل القديم
FIELD_ENCRYPTION_KEYS=generate-a-real-fernet-key-for-production
NATIONAL_ID_HMAC_KEY=generate-a-long-random-hmac-key-for-production

# Official Ministry calendar: scheduled sync/activation can be paused centrally.
MINISTRY_CALENDAR_ENABLED=true

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=/api/v1
# Polling is staggered per tab and backs off on failures. Values below are optional milliseconds.
# VITE_MONITORING_POLL_MS=10000
# VITE_TEACHER_PERIOD_POLL_MS=15000
# VITE_DASHBOARD_LIVE_POLL_MS=15000
# VITE_DASHBOARD_ATTENTION_POLL_MS=60000
# VITE_DASHBOARD_OVERVIEW_POLL_MS=120000
# VITE_DASHBOARD_ANALYTICS_POLL_MS=300000
# VITE_ATTENDANCE_ANALYTICS_POLL_MS=30000
# VITE_GATE_POLL_MS=15000
# VITE_MORNING_POLL_MS=30000
# VITE_DEVICE_STATUS_POLL_MS=30000
# VITE_JOB_STATUS_POLL_MS=5000
# Production nginx active API request ceiling (basic Blueprint: 16; scalable: 128).
# API_MAX_INFLIGHT=128
# Public parent activation/registration origin (HTTPS in production).
PARENT_PORTAL_BASE_URL=http://localhost:5173
# Reviewed school families: one SMS invitation, never absence eligibility changes.
PARENT_FAMILY_INVITATION_SMS_ENABLED=false
PARENT_FAMILY_INVITATION_SMS_ADAPTER=provider
PARENT_FAMILY_INVITATION_TTL_SECONDS=86400

# Recovery email only: verification + password reset. No student notifications.
# Configure an approved verified sending domain before enabling real delivery.
PARENT_RECOVERY_EMAIL_ENABLED=false
PARENT_RECOVERY_EMAIL_ADAPTER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TIMEOUT_SECONDS=10
PARENT_RECOVERY_VERIFY_TTL_SECONDS=86400
PARENT_RECOVERY_RESET_TTL_SECONDS=900
